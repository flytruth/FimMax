<!--
  Paste these rules inside the existing <group name="local,"> element of
  the Wazuh manager file /var/ossec/etc/rules/local_rules.xml.
  Rule IDs 100210-100215 must not already be used in that file.
-->
<rule id="100210" level="3">
  <decoded_as>json</decoded_as>
  <field name="event_type" type="pcre">^(CREATED|MODIFIED|DELETED|RENAMED)$</field>
  <description>Custom Python FIM: $(event_type) $(file_path) on $(hostname).</description>
  <group>custom_fim,</group>
</rule>
<rule id="100211" level="12">
  <if_sid>100210</if_sid>
  <field name="event_type" type="pcre">^MODIFIED$</field>
  <description>Custom Python FIM: monitored file modified ($(file_path)).</description>
  <group>custom_fim,syscheck,fim_modified,</group>
</rule>
<rule id="100212" level="12">
  <if_sid>100210</if_sid>
  <field name="event_type" type="pcre">^DELETED$</field>
  <description>Custom Python FIM: monitored file deleted ($(file_path)).</description>
  <group>custom_fim,syscheck,fim_deleted,</group>
</rule>
<rule id="100213" level="10">
  <if_sid>100210</if_sid>
  <field name="event_type" type="pcre">^RENAMED$</field>
  <description>Custom Python FIM: monitored file renamed ($(file_path)).</description>
  <group>custom_fim,syscheck,fim_renamed,</group>
</rule>
<rule id="100214" level="8">
  <if_sid>100210</if_sid>
  <field name="event_type" type="pcre">^CREATED$</field>
  <description>Custom Python FIM: monitored file created ($(file_path)).</description>
  <group>custom_fim,syscheck,fim_created,</group>
</rule>
<rule id="100215" level="14">
  <if_sid>100211,100212,100213,100214</if_sid>
  <field name="file_path" type="pcre">/etc/(passwd|shadow|group|sudoers)|/etc/ssh/sshd_config</field>
  <description>Custom Python FIM: authentication or access-control file changed ($(file_path)).</description>
  <group>custom_fim,syscheck,authentication,</group>
</rule>
